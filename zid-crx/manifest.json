{
  "manifest_version": 3,
  "name": "ZyZoom Internet Downloader",
  "version": "1.0.0",
  "description": "Floating ZyZoom Internet Downloader panel that lists every video, audio and playlist on the page and sends the link to the ZyZoom Internet Downloader app.",
  "author": "ZyZoom",
  "minimum_chrome_version": "111",
  "permissions": ["webRequest", "webNavigation", "cookies", "storage", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ZyZoom Internet Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["injected/youtube.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
